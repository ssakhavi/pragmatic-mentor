---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  date: string;
}
const { title, date } = Astro.props;
const SITE_TITLE = "The Pragmatic Mentor";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title ? `${title} · ${SITE_TITLE}` : SITE_TITLE}</title>
  <style>
    @import "../styles/global.css";

    main{max-width:680px;margin:0 auto;padding:64px 24px 96px;}
    .eyebrow{font-size:12.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
      color:var(--gray);margin:0 0 18px;}
    h1{font-size:2.2rem;font-weight:800;letter-spacing:-.01em;margin:0 0 16px;}
    p.meta{font-size:13px;color:var(--gray);margin:0 0 24px;}
    
    .prose{font-size:1.05rem;line-height:1.65;color:var(--ink);margin:0;}
    .prose p{margin:0 0 16px;}
    .prose p:last-child{margin-bottom:0;}
  </style>
</head>
<body>
  <Navigation />
  <main>
    <p class="eyebrow">Microblog</p>
    {title && <h1>{title}</h1>}
    <p class="meta">{date}</p>
    <div class="prose">
      <slot />
    </div>
  </main>
  <Footer showBackLink={true} backLinkText="Back to microblog" backLinkHref="/microblog/" />
</body>
</html>
