---
interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
const SITE_TITLE = "The Pragmatic Mentor";
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} &middot; {SITE_TITLE}</title>
  <style is:global>
    :root{
      --ink:#141414; --gray:#6e6e6e; --rule:#e6e6e6; --bg:#ffffff;
      --info:#1c5c8c; --warn:#b8720d; --cite:#555555; --hl:#8c1c1c;
      --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
      --mono:"SF Mono",Menlo,Consolas,monospace;
    }
    *{box-sizing:border-box;}
    html,body{margin:0;padding:0;background:var(--bg);color:var(--ink);
      font-family:var(--sans);-webkit-font-smoothing:antialiased;}
    a{color:inherit;}

    .site-nav{border-bottom:1px solid var(--rule);}
    .site-nav .inner{max-width:1180px;margin:0 auto;padding:20px 24px;
      display:flex;align-items:center;justify-content:space-between;}
    .wordmark{font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
      text-decoration:none;color:var(--ink);}
    .site-nav nav a{font-size:13px;color:var(--gray);text-decoration:none;margin-left:24px;}
    .site-nav nav a:hover{color:var(--ink);}
    .site-nav nav a.current{color:var(--ink);}

    main{max-width:680px;margin:0 auto;padding:64px 24px 96px;}
    h1{font-size:2.6rem;line-height:1.12;font-weight:800;letter-spacing:-.01em;margin:0 0 16px;}
    p.lead{font-size:1.05rem;color:var(--gray);margin:0 0 48px;line-height:1.6;}

    .prose{font-size:17px;line-height:1.75;}
    .prose p{margin:0 0 22px;}
    .prose h2{font-size:1.3rem;font-weight:700;margin:2.2em 0 .7em;letter-spacing:-.005em;}
    .prose h3{font-size:1.05rem;font-weight:700;margin:1.8em 0 .6em;}
    .prose a{color:var(--ink);text-decoration:underline;text-underline-offset:2px;}
    .prose ul,.prose ol{padding-left:1.3em;margin:0 0 22px;}
    .prose li{margin:0 0 4px;}
    .prose blockquote{margin:0 0 22px;padding-left:18px;border-left:3px solid var(--rule);
      color:var(--gray);font-style:italic;}
    .prose code{font-family:var(--mono);font-size:.85em;background:#f4f4f4;
      padding:.15em .4em;border-radius:3px;}
    .prose strong{font-weight:700;}
    .prose table{border-collapse:collapse;width:100%;margin:0 0 22px;font-size:.9em;}
    .prose th,.prose td{border:1px solid var(--rule);padding:8px 10px;text-align:left;}
    .prose thead{background:#f7f7f7;}
    .prose img{max-width:100%;height:auto;}
    .prose hr{border:none;border-top:1px solid var(--rule);margin:2.5em 0;}

    footer{border-top:1px solid var(--rule);padding:28px 24px;}
    footer .inner{max-width:1180px;margin:0 auto;display:flex;justify-content:space-between;
      font-size:12.5px;color:var(--gray);}
    footer a{color:var(--gray);text-decoration:none;}
    footer a:hover{color:var(--ink);}
  </style>
</head>
<body>
  <div class="site-nav">
    <div class="inner">
      <a class="wordmark" href={base}>{SITE_TITLE}</a>
      <nav>
        <a href={base}>Blog</a>
        <a href={`${base}glossary/`}>Glossary</a>
        <a href={`${base}tags/`}>Tags</a>
        <a href={`${base}about/`}>About</a>
        <a href={`${base}favorites/`}>Favorites</a>
      </nav>
    </div>
  </div>
  <main>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <div class="prose">
      <slot />
    </div>
  </main>
  <footer>
    <div class="inner">
      <span>&copy; {new Date().getFullYear()} Siavash Sakhavi</span>
      <a href={base}>Back to blog</a>
    </div>
  </footer>
</body>
</html>
