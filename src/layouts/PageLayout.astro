---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} &middot; The Pragmatic Mentor</title>
  <style is:global>
    @import "../styles/global.css";

    main{max-width:680px;margin:0 auto;padding:64px 24px 96px;}
    h1{font-size:2.6rem;line-height:1.12;font-weight:800;letter-spacing:-.01em;margin:0 0 16px;}
    p.lead{font-size:1.05rem;color:var(--gray);margin:0 0 48px;line-height:1.6;}
  </style>
</head>
<body>
  <Navigation />
  <main>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <div class="prose">
      <slot />
    </div>
  </main>
  <Footer showBackLink={true} backLinkText="Back to blog" backLinkHref={base} />
</body>
</html>
