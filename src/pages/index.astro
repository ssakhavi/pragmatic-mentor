---
import { getCollection } from "astro:content";
import { slugifyTag } from "../lib/slugify";
import { sortByDate } from "../lib/sortByDate";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

const posts = sortByDate(await getCollection("blog"));
const microPosts = sortByDate(await getCollection("microblog")).slice(0, 3);
const SITE_TITLE = "The Pragmatic Mentor";
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{SITE_TITLE}</title>
  <style>
    @import "../styles/global.css";

    main{max-width:680px;margin:0 auto;padding:64px 24px 96px;}
    .intro{margin:0 0 56px;}
    .eyebrow{font-size:12.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
      color:var(--gray);margin:0 0 18px;}
    h1{font-size:2.2rem;font-weight:800;letter-spacing:-.01em;margin:0 0 16px;}
    .intro p{font-size:1.05rem;line-height:1.65;color:var(--gray);margin:0 0 14px;max-width:580px;}
    .intro p:last-child{margin-bottom:0;}
    .intro a{color:var(--ink);text-decoration:underline;text-underline-offset:2px;}

    h2.section-title{font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
      color:var(--gray);margin:0 0 20px;padding-top:24px;border-top:1px solid var(--rule);}

    ul{list-style:none;margin:0;padding:0;}
    li{border-top:1px solid var(--rule);padding:22px 0;}
    li:first-child{border-top:none;}
    a.title{font-size:18px;font-weight:700;color:var(--ink);text-decoration:none;
      letter-spacing:-.005em;}
    a.title:hover{text-decoration:underline;text-underline-offset:3px;}
    p.description{font-size:14px;color:var(--gray);margin:6px 0 0;line-height:1.5;}
    p.meta{font-size:13px;color:var(--gray);margin:6px 0 0;}
    p.meta .sep{margin:0 7px;color:var(--rule);}
    p.meta .tag-link{color:var(--gray);text-decoration:none;}
    p.meta .tag-link:hover{color:var(--ink);text-decoration:underline;}

    .micro-section{margin-top:48px;}
    .micro-post{border-top:1px solid var(--rule);padding:16px 0;}
    .micro-post:first-child{border-top:none;}
    .micro-content{font-size:14px;line-height:1.6;color:var(--ink);margin:0 0 6px;}
    .micro-content p{margin:0;}
    .micro-date{font-size:12px;color:var(--gray);margin:0;}
    .micro-date a{color:var(--gray);text-decoration:none;}
    .micro-date a:hover{color:var(--ink);text-decoration:underline;}
  </style>
</head>
<body>
  <Navigation />
  <main>
    <div class="intro">
      <p class="eyebrow">Welcome</p>
      <h1>{SITE_TITLE}</h1>
      <p>Hi, my name is Siavash. I'm an AI Engineer / Mentor at AI Singapore.</p>
      <p>
        I have a passion for Machine Learning, Leadership, and Human Interactions.
        This blog is a way of showing my love for sharing my experiences and
        knowledge with others. Read more <a href={`${base}about/`}>about me</a>.
      </p>
    </div>
    {microPosts.length > 0 && (
      <>
        <h2 class="section-title">Quick Thoughts</h2>
        <div class="micro-section">
          {microPosts.map((post) => (
            <div class="micro-post">
              <div class="micro-content" set:html={post.render()} />
              <p class="micro-date">
                <a href={`${base}microblog/${post.slug}/`}>{post.data.date}</a>
              </p>
            </div>
          ))}
        </div>
      </>
    )}
    <h2 class="section-title">Posts</h2>
    <ul>
      {posts.map((post) => (
        <li>
          <a class="title" href={`${base}blog/${post.slug}/`}>{post.data.title}</a>
          {post.data.description && <p class="description">{post.data.description}</p>}
          <p class="meta">
            {post.data.date}
            {post.data.tags.map((t: string) => (
              <>
                <span class="sep">·</span><a href={`${base}tags/${slugifyTag(t)}/`} class="tag-link">{t}</a>
              </>
            ))}
          </p>
        </li>
      ))}
    </ul>
  </main>
  <Footer showSocialLinks={true} />
</body>
</html>
