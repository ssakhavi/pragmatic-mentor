---
const base = import.meta.env.BASE_URL;
const { showBackLink = false, backLinkText = "Back to top", backLinkHref = "#top", showSocialLinks = false } = Astro.props;
---
<footer>
  <div class="inner">
    <span>&copy; {new Date().getFullYear()} Siavash Sakhavi</span>
    {showBackLink && <a href={backLinkHref}>{backLinkText}</a>}
    {showSocialLinks && (
      <span>
        <a href="https://www.github.com/ssakhavi">GitHub</a>
        &nbsp;&middot;&nbsp;
        <a href="https://www.linkedin.com/in/siavashsakhavi/">LinkedIn</a>
      </span>
    )}
  </div>
</footer>
<style>
  footer {
    border-top: 1px solid var(--rule);
    padding: 28px 24px;
  }
  footer .inner {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    font-size: 12.5px;
    color: var(--gray);
  }
  footer a {
    color: var(--gray);
    text-decoration: none;
  }
  footer a:hover {
    color: var(--ink);
  }
</style>
